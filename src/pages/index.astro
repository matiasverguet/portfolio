---
import Layout from '../layouts/Layout.astro';
import Folder from '../components/Folder.astro';
import Skills from '../components/Skills.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { profile } from '../data/portfolio';
---
<Layout>
  <section class="relative mx-auto h-[670px] w-[84%] max-w-[1220px] pt-[180px] max-[1000px]:h-[520px] max-[1000px]:pt-[150px] max-[640px]:h-[470px] max-[640px]:pt-[150px]" aria-labelledby="hero-title">
    <Folder class="absolute left-[-1%] top-[68px] z-[2] h-[135px] w-[170px] -rotate-8 max-[1000px]:left-auto max-[1000px]:top-[55px] max-[1000px]:h-[100px] max-[1000px]:w-[125px] max-[640px]:left-[3%] max-[640px]:top-[55px] max-[640px]:h-[70px] max-[640px]:w-[88px]" />
    <Folder class="absolute left-[66%] top-[60px] z-[2] h-[135px] w-[170px] rotate-[11deg] max-[1000px]:left-auto max-[1000px]:top-[55px] max-[1000px]:h-[100px] max-[1000px]:w-[125px] max-[640px]:left-[67%] max-[640px]:top-[58px] max-[640px]:h-[70px] max-[640px]:w-[88px]"><div class="absolute inset-[-25px_0_0] flex items-start justify-center gap-[3px]"><span class="h-[75px] w-[75px] rotate-[-25deg] rounded-full bg-[#a6ed6e] text-center text-[70px] leading-[.85] max-[640px]:h-[45px] max-[640px]:w-[45px] max-[640px]:text-[43px]">≋</span><span class="text-[94px] leading-[.7] text-[#ff6552] [text-shadow:10px_36px_#13c7fb] max-[640px]:text-[55px] max-[640px]:[text-shadow:5px_23px_#13c7fb]">●</span></div></Folder>
    <div class="relative ml-[5%] w-[92%] border-[3px] border-dotted border-[#657aff] px-5 pb-[30px] pt-[25px] max-[640px]:ml-0 max-[640px]:w-full max-[640px]:border-2 max-[640px]:px-2.5 max-[640px]:py-4">
      <span class="absolute left-[-6px] top-[-6px] h-[9px] w-[9px] border border-[#657aff] bg-white" aria-hidden="true"></span><span class="absolute right-[-6px] top-[-6px] h-[9px] w-[9px] border border-[#657aff] bg-white" aria-hidden="true"></span>
      <h1 id="hero-title" class="whitespace-nowrap text-[clamp(44px,7.35vw,108px)] font-black uppercase leading-[1.02] tracking-[-.055em] max-[640px]:text-[clamp(25px,7.1vw,46px)]"><span class="block text-electric">Matias</span>Verguet--Bailly</h1>
      <p class="mt-1.5 font-serif text-[clamp(24px,3.2vw,43px)] max-[640px]:text-2xl">Designer graphique</p>
      <span class="absolute bottom-[-6px] left-[-6px] h-[9px] w-[9px] border border-[#657aff] bg-white" aria-hidden="true"></span><span class="absolute bottom-[-6px] right-[-6px] h-[9px] w-[9px] border border-[#657aff] bg-white" aria-hidden="true"></span>
      <svg class="absolute bottom-[-70px] right-[-50px] w-[52px] -rotate-8 text-electric max-[1000px]:bottom-[-52px] max-[1000px]:right-[-36px] max-[1000px]:w-[38px] max-[640px]:right-0 max-[640px]:w-8" viewBox="0 0 50 65" aria-hidden="true"><path fill="currentColor" d="M3 2v49l13-12 12 24 12-6-12-24 20-2z" /></svg>
    </div>
    <Folder class="absolute right-[-5%] top-[310px] z-[2] h-[135px] w-[170px] -rotate-[18deg] max-[1000px]:top-[265px] max-[1000px]:h-[100px] max-[1000px]:w-[125px] max-[640px]:right-[-3%] max-[640px]:top-[260px] max-[640px]:h-[70px] max-[640px]:w-[88px]" />
    <Folder class="absolute left-[16%] top-[495px] z-[2] h-[135px] w-[170px] rotate-[13deg] max-[1000px]:top-[390px] max-[1000px]:h-[100px] max-[1000px]:w-[125px] max-[640px]:left-[10%] max-[640px]:top-[345px] max-[640px]:h-[70px] max-[640px]:w-[88px]" />
    <p class="mt-8 mr-[5%] text-right font-display text-2xl max-[1000px]:text-xl max-[640px]:mt-20 max-[640px]:mr-0 max-[640px]:text-[17px]">{profile.internship}</p>
  </section>
  <div class="mx-auto w-[84%] max-w-[1220px]">
    <Skills />
    <section class="mt-[210px] grid grid-cols-[.9fr_1fr] items-center gap-[12%] max-[1000px]:mt-[150px] max-[1000px]:gap-[7%] max-[640px]:mt-[90px] max-[640px]:grid-cols-1 max-[640px]:gap-[50px]" aria-labelledby="about-title">
      <div class="px-5 pt-20 max-[640px]:mx-auto max-[640px]:mt-10 max-[640px]:w-[78%] max-[640px]:max-w-[330px]"><Folder class="relative h-[280px] w-full -rotate-[13deg] max-[1000px]:h-[220px] max-[640px]:h-[200px]"><img class="absolute bottom-[50%] left-0 w-full" src="/images/avatar.webp" alt="Portrait de Matias" width="800" height="800" /></Folder></div>
      <div class="about-copy">
        <h2 id="about-title" class="font-display text-[clamp(32px,4vw,58px)] font-medium uppercase leading-[1.2]">À propos</h2>
        <p class="mt-[25px] text-[19px] leading-[1.55] max-[1000px]:text-base max-[640px]:text-[17px]">Je m’appelle Matias Verguet--Bailly, j’ai 19 ans et je suis actuellement en deuxième année de BUT Métiers du Multimédia et de l’Internet. Je souhaite me spécialiser dans le webdesign et le graphisme.</p>
        <div class="my-[25px] mb-[35px] flex gap-[70px] max-[1000px]:gap-10 max-[640px]:gap-[60px]"><div><strong class="block font-display text-[55px] leading-[1.1] text-electric max-[1000px]:text-[45px]">2ème</strong><span class="text-[19px] max-[1000px]:text-base">Année MMI</span></div><div><strong class="block font-display text-[55px] leading-[1.1] text-electric max-[1000px]:text-[45px]">10+</strong><span class="text-[19px] max-[1000px]:text-base">Projets</span></div></div>
        <div class="flex flex-wrap gap-10 text-lg max-[1000px]:gap-5 max-[1000px]:text-[15px]"><div><b class="block">Tél :</b><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a></div><div><b class="block">Email :</b><a href={`mailto:${profile.email}`}>{profile.email}</a></div></div>
        <a class="float-right mt-[35px] inline-flex items-center justify-center gap-[22px] rounded-full bg-electric px-6 py-3.5 text-[15px] uppercase text-white transition hover:-translate-y-0.5 hover:bg-[#0827cc] max-[640px]:float-none" href="/about">Me découvrir <span class="text-[25px] leading-[.8]" aria-hidden="true">→</span></a>
      </div>
    </section>
    <section class="mb-[240px] mt-[170px] max-[640px]:mb-[100px] max-[640px]:mt-[90px]" aria-labelledby="projects-title">
      <h2 id="projects-title" class="font-display text-[clamp(32px,4vw,58px)] font-medium uppercase leading-[1.2]">Mes projets</h2>
      <ProjectGrid />
      <div class="mt-[30px] flex justify-end max-[640px]:mt-[45px] max-[640px]:justify-center"><a class="inline-flex items-center justify-center gap-[22px] rounded-full bg-electric px-6 py-3.5 text-[15px] uppercase text-white transition hover:-translate-y-0.5 hover:bg-[#0827cc]" href="/projets">Plus de projets <span class="text-[25px] leading-[.8]" aria-hidden="true">→</span></a></div>
    </section>
  </div>
</Layout>
