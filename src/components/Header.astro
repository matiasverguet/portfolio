---
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header">
  <a class="logo" href="/" aria-label="Matias Verguet--Bailly — Accueil"><img src="/images/logo.svg" alt="MVB" width="68" height="40" /></a>
  <nav aria-label="Navigation principale">
    <a href="/projets" aria-current={path === '/projets' ? 'page' : undefined}>Projet</a>
    <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
    <a class="contact-link" href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a>
  </nav>
  <a class="edition" href="/">Portfolio-2026</a>
</header>
