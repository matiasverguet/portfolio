---
import { skills } from '../data/portfolio';
---
<section class="section my-[120px] max-w-[940px] max-[1000px]:my-[100px] max-[640px]:my-[70px]" aria-labelledby="skills-title">
  <h2 id="skills-title" class="font-display text-[clamp(32px,4vw,58px)] font-medium uppercase leading-[1.2]">Mes compétences</h2>
  <p class="mt-7 max-w-[820px] text-[clamp(17px,1.65vw,24px)] leading-[1.35] max-[640px]:mt-5">Je combine créativité et maîtrise technique pour développer<br class="max-[640px]:hidden" /> des projets en web design, UX/UI et identité de marque.</p>
  <div class="ml-[5%] mt-[30px] w-[84%] max-[640px]:ml-0 max-[640px]:mt-5 max-[640px]:w-full">
    {skills.map((skill, i) => (
      <details>
        <summary class="flex cursor-pointer list-none items-center gap-[18px] py-3.5 font-display text-[clamp(22px,3vw,40px)] font-normal not-italic max-[640px]:gap-2.5 max-[640px]:py-3 max-[640px]:text-2xl"><span class="min-w-8 text-[.7em] max-[640px]:min-w-6">{i + 1}.</span><span>{skill.title}</span><span class="ml-auto mr-2.5 h-[22px] w-[22px] rotate-45 border-b-[3px] border-r-[3px] transition-transform max-[640px]:mr-1 max-[640px]:h-[15px] max-[640px]:w-[15px] max-[640px]:border-b-2 max-[640px]:border-r-2" aria-hidden="true"></span></summary>
          <ul class="mb-[18px] ml-[52px] mr-10 max-w-[700px] list-none pl-0 text-[17px] not-italic max-[640px]:ml-[34px] max-[640px]:mr-2.5 max-[640px]:text-base">{skill.description.map((item) => <li class="mt-3.5 leading-[1.35]">{item}</li>)}</ul>
      </details>
    ))}
  </div>
</section>
