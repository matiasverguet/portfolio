---
import { projects } from '../data/portfolio';
---
<div class="mt-[110px] grid grid-cols-3 gap-[35px] max-[640px]:mt-[45px] max-[640px]:grid-cols-1 max-[640px]:gap-[50px]">
  {projects.map(project => (
    <figure class="project-card m-0 text-center max-[640px]:mx-auto max-[640px]:w-[90%] max-[640px]:max-w-[380px]" data-category={project.category}>
      <a class="block" href={project.href}>
      <div class="group relative">
        <div class="relative aspect-[440/320] w-full" role="img" aria-label={`Dossier du projet ${project.title}`}>
          {project.hoverImage && <img class={`pointer-events-none absolute z-[1] opacity-100 transition-all duration-500 ease-out ${project.number === '01' ? 'left-[5%] top-[-35%] w-[120%] group-hover:left-[7%] group-hover:top-[-48%] group-hover:scale-110' : project.number === '02' ? 'left-[9%] top-[-5%] w-[82%] group-hover:left-[9%] group-hover:top-[-25%] group-hover:scale-105' : 'left-[25%] top-[4%] w-[62%] group-hover:left-[25%] group-hover:top-[-18%] group-hover:scale-105'}`} src={project.hoverImage} alt="" width="512" height="512" loading="lazy" />}
          <div class="absolute left-[7%] top-[15%] h-[25%] w-[86%] rounded-t-[18px] bg-[#087fb8] shadow-[0_8px_20px_rgba(0,0,0,0.12)]"></div>
          <div class="absolute inset-x-[7%] bottom-[3%] top-[25%] z-[2] rounded-[18px] bg-folder"></div>
        </div>
        {project.number && <div class="absolute inset-x-[9%] bottom-[8%] z-10 h-[61%] bg-folder text-left">
          <span class="font-display text-[clamp(26px,3vw,42px)] leading-none">{project.number}</span>
          <h3 class="mt-2 max-w-[75%] font-display text-[clamp(14px,1.55vw,21px)] uppercase leading-[.95]">{project.cardTitle}</h3>
          <div class="mt-2 flex flex-wrap gap-1.5 font-sans text-[10px]">
            {project.tags?.map((tag) => <span class="rounded-full border border-current px-1.5 py-0.5 leading-none">{tag}</span>)}
          </div>
          <span class="mt-2 block text-xl leading-none" aria-hidden="true">→</span>
        </div>}
      </div>
      </a>
      {!project.number && <figcaption class="mt-[17px] font-serif text-[clamp(22px,2.5vw,35px)] leading-[1.2]">{project.title}</figcaption>}
    </figure>
  ))}
</div>
